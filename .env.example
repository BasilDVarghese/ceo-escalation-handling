# --- Claude / Anthropic (direct client — kept wired in as the fallback provider) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# --- LLM provider (Bedrock primary, direct Anthropic automatic fallback) ---
LLM_PROVIDER=bedrock
# Exact Bedrock model ID / inference-profile ARN varies by AWS account and region — verify
# in the Bedrock console (Model access) and copy the exact ID; not guessed here.
BEDROCK_MODEL_ID=REPLACE_ME
# Optional — if unset, uses boto3's standard credential-chain default region.
AWS_REGION=

# --- DynamoDB (routing taxonomy + escalation audit trail) ---
# Set to http://localhost:8000 for DynamoDB Local (see docker-compose.yml); leave unset
# to use real AWS DynamoDB via the standard credential chain.
DYNAMODB_ENDPOINT_URL=
DYNAMODB_ESCALATIONS_TABLE=escalations
DYNAMODB_TEAMS_TABLE=teams

# --- Gmail ---
GMAIL_CREDENTIALS_PATH=data/credentials.json
GMAIL_TOKEN_PATH=data/token.json
GMAIL_POLL_INTERVAL_MINUTES=5
# Only messages matching this Gmail search query are treated as candidate escalations.
# Apply the "escalation" label yourself (manually, or via a Gmail filter) to control volume.
GMAIL_QUERY_FILTER=is:unread label:escalation
GMAIL_PROCESSED_LABEL=escalation-processed
SENDER_EMAIL=ceo-assistant@example.com

# --- LangGraph checkpoint persistence ---
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# --- JWT / dev auth (api.py) — NOT a real identity provider, demo/dev only ---
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
DEV_OPERATOR_PASSWORD=operator-dev-password
DEV_APPROVER_PASSWORD=approver-dev-password

# --- FastAPI service ---
# Runs the Gmail poller as a background task inside the API process when true — the
# recommended way to run this app once the API is in use (see README's Concurrency note).
ENABLE_POLLER=true

# --- Reminders ---
# 1. Create an OAuth client (Desktop app type) in Google Cloud Console, enable the Gmail API,
#    download the JSON as credentials.json into data/.
# 2. First run of `python main.py run` (or the API's background poller) opens a browser for
#    OAuth consent and creates token.json.
# 3. Request model access for your chosen Bedrock model in the AWS Bedrock console — this is
#    a per-account, per-region grant and a common first-run gotcha.
# 4. Run `docker compose up -d` (DynamoDB Local) or point at real AWS, then
#    `python -m scripts.dynamodb_setup` to create + seed the tables.
# 5. Edit team owner_email values before relying on real routing (see README).
